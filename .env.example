# Copy to .env and fill in. .env is in .gitignore and must never be committed.

# PostgreSQL
POSTGRES_DB=incidentiq
POSTGRES_USER=incidentiq
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Neo4j (password: at least 8 characters)
NEO4J_PASSWORD=change-me-too
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# Ports on the Docker host (the server may be shared: avoid the standard ports)
POSTGRES_HOST_PORT=15432
NEO4J_HTTP_HOST_PORT=17474
NEO4J_BOLT_HOST_PORT=17687